# Seed refresh token from a logged-in tv4play.se session. Only read when
# .state/refresh_token doesn't exist; tokens rotate on every refresh and the
# latest one is written to .state/refresh_token.
TV4_REFRESH_TOKEN=

# Client identity sent to TV4 APIs. Bump TV4_CLIENT_VERSION if the GraphQL
# gateway starts answering CLIENT_IS_DEPRECATED (value is in the web bundle).
TV4_CLIENT_NAME=tv4-web
TV4_CLIENT_VERSION=5.5.0

# Sent on every request to TV4.
USER_AGENT=nyhetsmorgon-highlights/0.1 (+https://github.com/<you>/nyhetsmorgon-highlights)

# Minimum delay between requests to TV4 servers, in ms.
REQUEST_INTERVAL_MS=250

# Local working files (audio, transcripts). Never committed.
WORK_DIR=work

# Transcription. whisper-cpp: `brew install whisper-cpp`, model from
# https://huggingface.co/KBLab/kb-whisper-large/resolve/main/ggml-model.bin
TRANSCRIBE_BACKEND=whisper-cpp
WHISPER_CLI=whisper-cli
WHISPER_MODEL=models/kb-whisper-large.bin
WHISPER_THREADS=8

# Segmentation LLM. claude-cli uses your logged-in Claude Code (`claude -p`).
LLM_BACKEND=claude-cli
LLM_MODEL=sonnet
CLAUDE_CLI=claude
SEGMENT_CHUNK_MINUTES=40
